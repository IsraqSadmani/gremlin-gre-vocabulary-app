{
  "name": "gremlin-vocab-trainer",
  "version": "1.0.0",
  "description": "Flashcards, synonym recall and quizzes for Gremlin's GRE Vocabulary Lists 1-15.",
  "author": "Md Israq Sadmani",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.israq.gremlinvocab",
    "productName": "Gremlin Vocab Trainer",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**", "www/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Gremlin-Vocab-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Gremlin-Vocab-Portable-${version}.${ext}" },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.education" },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Education" }
  }
}
